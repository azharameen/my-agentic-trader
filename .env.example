# =============================================================================
# NIFTY 100 Swing Trading Assistant — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- LLM (qualitative research filter only) --------------------------------
# Select one: openai_compatible (default), openai, gemini, anthropic, groq.
LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
RESEARCH_CACHE_ENABLED=true
TECHNICAL_CACHE_MINUTES=360
NEWS_CACHE_MINUTES=30
CATALYST_CACHE_MINUTES=1440
EVIDENCE_CACHE_MINUTES=1440
EVIDENCE_MAX_AGE_SECONDS=0

# --- Telegram (Human-in-the-Loop approval) ---------------------------------
# Create a bot via @BotFather to get the token.
# Get your chat id by messaging the bot and hitting the getUpdates API.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here
TELEGRAM_CHAT_ID=123456789

# --- Execution mode & capital ----------------------------------------------
# PAPER_TRADING (default, safe) | LIVE (blocked until a broker adapter exists)
TRADING_MODE=PAPER_TRADING
PORTFOLIO_CAPITAL=100000.0

# --- Deterministic risk invariants (hardcoded math, no LLM) ----------------
RISK_PER_TRADE_PCT=0.01
ATR_SOFT_MULT=1.5
ATR_HARD_MULT=2.5
MIN_RISK_TO_REWARD=2.0

# --- Persistence (relative to the container working dir) -------------------
DATABASE_PATH=data/trading_audit.db
CHECKPOINT_DB_PATH=data/checkpoints.db
STORE_DB_PATH=data/store.db
DATABASE_BACKUP_DIR=data/backups

# --- Screener parameters ----------------------------------------------------
RSI_OVERSOLD_MAX=42.0
VOLUME_RATIO_MIN=0.5
HISTORY_PERIOD=1y
SCREENER_MAX_WORKERS=8
SETUP_STRATEGY=pullback_in_uptrend

# --- Observability (Phase 3) -----------------------------------------------
# Keep disabled for normal local runs; enable console export while debugging.
OTEL_ENABLED=false
OTEL_CONSOLE_EXPORTER=false

# --- LangSmith tracing (optional, ADR-021) ----------------------------------
# Off by default. Get a free API key at https://smith.langchain.com/settings.
# Enabling this sends run/trace metadata (not secrets) to LangSmith's servers
# (or LANGSMITH_ENDPOINT if self-hosted). Leave LANGSMITH_TRACING_ENABLED=false
# unless you have explicitly reviewed what LangSmith stores.
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=traid
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Universe (NIFTY 100 constituents) --------------------------------------
UNIVERSE_SEED_PATH=config/universe/nifty100_seed.csv
UNIVERSE_CACHE_PATH=data/universe/nifty100.csv
UNIVERSE_SOURCE_URL=https://www.niftyindices.com/IndexConstituent/ind_nifty100list.csv
UNIVERSE_REFRESH_DAYS=30

# --- Human approval / scheduling ---------------------------------------------
STALE_PROPOSAL_MINUTES=240
STALE_PROPOSAL_PRICE_MOVE_PCT=0.02
CORPORATE_EVENT_BLACKOUT_DAYS=10
CORPORATE_EVENTS_ENABLED=false
CORPORATE_EVENTS_SOURCE_URL=
CORPORATE_EVENTS_CACHE_PATH=data/corporate_events.json
SCAN_CRON_HOUR=15
SCAN_CRON_MINUTE=45
SCAN_CRON_DAYS=mon-fri
SCHEDULER_TIMEZONE=Asia/Kolkata
UNIVERSE_REFRESH_DAY_OF_MONTH=1
UNIVERSE_REFRESH_HOUR=6
UNIVERSE_REFRESH_MINUTE=0
